// Apps Script web app: JSONP-friendly handlers (GET) + safe updates using LockService.
// Deploy as Web App (Execute as: Me, Who has access: Anyone, even anonymous).

const SHEET_USERS = 'users';
const SHEET_META = 'meta';
const DEFAULT_ADMIN_PW = 'changeme';

function getAdminPassword() {
  const sp = PropertiesService.getScriptProperties().getProperty('ADMIN_PASSWORD');
  return sp || DEFAULT_ADMIN_PW;
}

function ensureSheets() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  if (!ss.getSheetByName(SHEET_USERS)) {
    const s = ss.insertSheet(SHEET_USERS);
    s.appendRow(['id','name','score','createdAt']);
  }
  if (!ss.getSheetByName(SHEET_META)) {
    const m = ss.insertSheet(SHEET_META);
    m.appendRow(['key','value']);
    m.appendRow(['currentQuestionId','']);
  }
}

function readUsers() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(SHEET_USERS);
  if (!sheet) return [];
  const rows = sheet.getDataRange().getValues();
  const headers = rows.shift();
  return rows.map(r => {
    const obj = {};
    headers.forEach((h,i) => obj[h] = r[i]);
    obj.score = Number(obj.score) || 0;
    return obj;
  });
}

function appendUser(user) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(SHEET_USERS);
  sheet.appendRow([user.id, user.name, user.score, user.createdAt]);
}

function getMeta(key) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const s = ss.getSheetByName(SHEET_META);
  if (!s) return null;
  const rows = s.getDataRange().getValues();
  for (let i=1;i<rows.length;i++){
    if (rows[i][0] === key) return rows[i][1];
  }
  return null;
}
function setMeta(key, value) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const s = ss.getSheetByName(SHEET_META);
  const rows = s.getDataRange().getValues();
  for (let i=1;i<rows.length;i++){
    if (rows[i][0] === key) {
      s.getRange(i+1,2).setValue(value);
      return;
    }
  }
  s.appendRow([key, value]);
}

// JSONP helper
function jsonResponse(obj, callback) {
  const payload = JSON.stringify(obj);
  if (callback) {
    return ContentService.createTextOutput(callback + '(' + payload + ')').setMimeType(ContentService.MimeType.JAVASCRIPT);
  } else {
    return ContentService.createTextOutput(payload).setMimeType(ContentService.MimeType.JSON);
  }
}

// Support GET for read or write actions via query params (JSONP-friendly).
function doGet(e) {
  const action = (e.parameter.action || '').toLowerCase();
  const callback = e.parameter.callback;
  try {
    if (action === 'users') {
      const users = readUsers();
      return jsonResponse({ ok:true, users: users }, callback);
    } else if (action === 'question') {
      const id = getMeta('currentQuestionId') || '';
      return jsonResponse({ ok:true, currentQuestionId: String(id) }, callback);
    } else if (action === 'register') {
      const name = (e.parameter.name || '').trim();
      if (!name) return jsonResponse({ ok:false, error:'name required' }, callback);
      const lock = LockService.getScriptLock();
      lock.waitLock(30000);
      try {
        const users = readUsers();
        const existing = users.find(u => (u.name || '').toLowerCase() === name.toLowerCase());
        if (existing) {
          return jsonResponse({ ok:true, user: existing }, callback);
        } else {
          const user = { id: String(Date.now()), name: name, score: 0, createdAt: (new Date()).toISOString() };
          appendUser(user);
          return jsonResponse({ ok:true, user: user }, callback);
        }
      } finally {
        lock.releaseLock();
      }
    } else if (action === 'incscore') {
      const name = e.parameter.name || '';
      const amount = Number(e.parameter.amount || 1);
      if (!name) return jsonResponse({ ok:false, error: 'name or id required' }, callback);
      const lock = LockService.getScriptLock();
      lock.waitLock(30000);
      try {
        const ss = SpreadsheetApp.getActiveSpreadsheet();
        const sheet = ss.getSheetByName(SHEET_USERS);
        const data = sheet.getDataRange().getValues();
        const headers = data.shift();
        let updated = null;
        for (let r=0;r<data.length;r++){
          const row = data[r];
          const rowObj = {};
          headers.forEach((h,i)=>rowObj[h]=row[i]);
          if (String(rowObj.name).toLowerCase() === String(name).toLowerCase()) {
            const newScore = (Number(rowObj.score)||0) + amount;
            sheet.getRange(r+2, headers.indexOf('score')+1).setValue(newScore);
            updated = { ...rowObj, score: newScore };
            break;
          }
        }
        if (!updated) return jsonResponse({ ok:false, error:'user not found' }, callback);
        return jsonResponse({ ok:true, updated: updated }, callback);
      } finally {
        lock.releaseLock();
      }
    } else if (action === 'setcurrentquestion') {
      const pw = e.parameter.password || '';
      if (pw !== getAdminPassword()) return jsonResponse({ ok:false, error:'forbidden' }, callback);
      const qid = e.parameter.questionId || '';
      setMeta('currentQuestionId', String(qid));
      return jsonResponse({ ok:true, message:'ok' }, callback);
    } else {
      return jsonResponse({ ok:true, message:'Apps Script endpoint' }, callback);
    }
  } catch (err) {
    return jsonResponse({ ok:false, error: String(err) }, e.parameter.callback);
  }
}

// Allow preflight if some client uses OPTIONS (not typically used for JSONP)
function doOptions(e) {
  return ContentService.createTextOutput().setMimeType(ContentService.MimeType.JSON);
}
